# ---- core ----
JARVIS_ENV=development
JARVIS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JARVIS_DATA_DIR=./data
JARVIS_DATABASE_URL=sqlite:///./data/jarvis.sqlite3
# For Postgres: postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_REDIS_URL=redis://localhost:6379/0
JARVIS_FRONTEND_DIST=./apps/web/dist
JARVIS_ALLOW_SIGNUP=true
JARVIS_TOKEN_TTL_MINUTES=1440
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# ---- LLM providers (auto = Anthropic if key else OpenAI if key else local deterministic) ----
JARVIS_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JARVIS_ANTHROPIC_MODEL_FAST=claude-haiku-4-5
JARVIS_ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5
JARVIS_OPENAI_MODEL_FAST=gpt-4o-mini
JARVIS_OPENAI_MODEL_STRONG=gpt-4o
JARVIS_OLLAMA_URL=http://localhost:11434

# ---- STT/TTS (configure local vs cloud) ----
JARVIS_STT_PROVIDER=local
JARVIS_TTS_PROVIDER=local
JARVIS_WAKEWORD_PROVIDER=local

# ---- integrations ----
TAVILY_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ---- logging & observability ----
JARVIS_LOG_LEVEL=INFO
JARVIS_OTEL_ENABLED=false

# ---- limits ----
JARVIS_MAX_TOOL_CALLS=20
JARVIS_MAX_RUNTIME_S=120

# ---- security ----
JARVIS_ALLOW_REMOTE_ACCESS=false
