# ---- core ----
AGENCYOS_SECRET_KEY=change-me-to-a-long-random-string   # JWT signing + secret encryption. Generated in data/ if unset (dev only)
AGENCYOS_DATA_DIR=./data                                # sqlite db, workspaces, deployments
AGENCYOS_ALLOW_SIGNUP=true
AGENCYOS_TOKEN_TTL_MINUTES=1440

# ---- LLM providers (auto = Anthropic if key, else OpenAI if key, else local deterministic) ----
AGENCYOS_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENCYOS_ANTHROPIC_MODEL_FAST=claude-haiku-4-5
AGENCYOS_ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5
AGENCYOS_OPENAI_MODEL_FAST=gpt-4o-mini
AGENCYOS_OPENAI_MODEL_STRONG=gpt-4o

# ---- integrations ----
TAVILY_API_KEY=                 # web research
NETLIFY_AUTH_TOKEN=             # real deploys (otherwise local preview host)
NETLIFY_SITE_ID=

# ---- agent catalogue ----
AGENCYOS_AGENT_REPO_URL=https://github.com/ashishpatel26/500-AI-Agents-Projects
AGENCYOS_AGENT_REPO_PATH=       # use an existing local clone instead of cloning
AGENCYOS_ENABLE_EXTERNAL_AGENTS=false   # third-party agents only ever run in Docker

# ---- safety limits ----
AGENCYOS_STEP_DELAY=0.6         # pacing between tasks so humans can follow the live build
AGENCYOS_MAX_TASK_RETRIES=2
AGENCYOS_MAX_REVISIONS=3
AGENCYOS_MAX_PROJECT_EXECUTIONS=400
AGENCYOS_MAX_PROJECT_BUDGET_USD=25
