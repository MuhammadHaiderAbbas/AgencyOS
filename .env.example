# ---- core ----
AGENCYOS_SECRET_KEY=change-me-to-a-long-random-string   # JWT signing + secret encryption. Generated in data/ if unset (dev only)
AGENCYOS_DATA_DIR=./data                                # sqlite db, workspaces, deployments
AGENCYOS_ALLOW_SIGNUP=true
AGENCYOS_TOKEN_TTL_MINUTES=1440
AGENCYOS_BASE_URL=http://localhost:8000                 # used for Stripe success/cancel + referral links

# ---- LLM providers (auto = Anthropic if key, else OpenAI if key, else local deterministic) ----
AGENCYOS_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENCYOS_ANTHROPIC_MODEL_FAST=claude-haiku-4-5
AGENCYOS_ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5
AGENCYOS_OPENAI_MODEL_FAST=gpt-4o-mini
AGENCYOS_OPENAI_MODEL_STRONG=gpt-4o

# ---- earning: Stripe (platform billing + client checkout for generated sites) ----
# When unset: Demo earning mode — upgrades are instant, client checkout returns mock URL so whole site earns in demo.
# When set: Real charges via Stripe Checkout + customer portal + webhooks.
STRIPE_SECRET_KEY=                # e.g. sk_test_... or sk_live_...
STRIPE_PUBLISHABLE_KEY=           # pk_test_... (exposed to frontend for client sites via assets/config.js)
STRIPE_WEBHOOK_SECRET=            # whsec_... to verify POST /api/billing/webhook
STRIPE_PRICE_PRO=                 # price_... for £29/mo Pro plan (create in Stripe Dashboard)
STRIPE_PRICE_BUSINESS=            # price_... for £99/mo Business plan

# ---- earning: referrals ----
# No env needed — referrals auto-create from ?ref=<org_id[:8]> on signup and credit £5/£15 on upgrade.

# ---- email (real notifications; mock log if unset — site stays working) ----
SMTP_HOST=                        # e.g. smtp.sendgrid.net or smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@example.com       # must be verified with your SMTP provider
SMTP_USE_TLS=true

# ---- GitHub (push generated project git to GitHub) ----
GITHUB_TOKEN=                     # PAT with `repo` scope — enables POST /api/projects/{id}/push
GITHUB_CLIENT_ID=                 # for OAuth (optional)
GITHUB_CLIENT_SECRET=

# ---- deployments: set any to enable real deploy (local /sites always works) ----
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
RENDER_DEPLOY_HOOK_URL=           # static site deploy hook
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---- integrations ----
TAVILY_API_KEY=                   # web research for Researcher agent

# ---- agent catalogue ----
AGENCYOS_AGENT_REPO_URL=https://github.com/ashishpatel26/500-AI-Agents-Projects
AGENCYOS_AGENT_REPO_PATH=         # use existing local clone instead of cloning
AGENCYOS_ENABLE_EXTERNAL_AGENTS=false   # third-party agents only ever run in Docker

# ---- safety limits (also enforce plan limits for earning) ----
AGENCYOS_STEP_DELAY=0.6           # pacing between tasks so humans can follow live build
AGENCYOS_MAX_TASK_RETRIES=2
AGENCYOS_MAX_REVISIONS=3
AGENCYOS_MAX_PROJECT_EXECUTIONS=400
AGENCYOS_MAX_PROJECT_BUDGET_USD=25

# ---- generated client sites: their own Stripe for direct earning ----
# Each generated API (source/api) reads its own .env:
# STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, BOOKING_SUCCESS_URL, ORDER_SUCCESS_URL, ADMIN_TOKEN, ALLOWED_ORIGIN
